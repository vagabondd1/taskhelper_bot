# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Qwen LLM
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT=60

# Token limits
GUIDED_MODE_MAX_TOKENS=512
FULL_SOLUTION_MAX_TOKENS=2048

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=task_helper
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# App
LOG_LEVEL=INFO
MAX_USER_MESSAGE_LENGTH=4096

# Rate limit (per user, sliding window) — требует Redis
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Redis
REDIS_URL=redis://redis:6379/0

# Cooldown между отправками новой задачи (секунды)
NEW_TASK_COOLDOWN_SECONDS=10
